<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PIA.AddProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PIA"
    xmlns:model="using:PIA.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel
            Width="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

                <TextBlock Text="Agregar nuevo producto"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- Nombre -->
                <TextBlock Text="Nombre del producto"/>
                <TextBox x:Name="NombreBox" MaxLength="50" PlaceholderText="Máx. 50 caracteres"/>

                <!-- Icono -->
                <TextBlock Text="Icono (emoji)"/>
                <TextBox x:Name="IconoBox" PlaceholderText="Ej: 🔧 🧰 💡"/>

                <!-- Categoría -->
                <TextBlock Text="Categoría"/>
                <ComboBox x:Name="CategoriaBox"
                            PlaceholderText="Selecciona una categoría"
                            ItemsSource="{x:Bind model:Categorias.Lista}"/>

                <!-- Precio -->
                <TextBlock Text="Precio"/>
                <TextBox x:Name="PrecioBox" MaxLength="10" PlaceholderText="Máx. 10 digitos"/>

                <!-- Stock -->
                <TextBlock Text="Stock disponible"/>
                <TextBox x:Name="StockBox" MaxLength="6" BeforeTextChanging="SoloNumeros_Entero" PlaceholderText="Máx. 6 digitos"/>

                <!-- Marca -->
                <TextBlock Text="Marca"/>
                <TextBox x:Name="MarcaBox" MaxLength="50" PlaceholderText="Máx. 50 caracteres"/>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,20,0,0">

                    <Button Content="Guardar producto" Click="Guardar_Click"/>

                    <Button Content="Cancelar" Click="Cancelar_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
