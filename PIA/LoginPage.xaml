<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PIA.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PIA"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Image Source="ms-appx:///Assets/Fondo.png" Stretch="Fill"/>
        <Rectangle Fill="#551B2533"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="1"
                Width="360"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                CornerRadius="15"
                Padding="32,8,32,16"
                Background="#1E2D3D">

                <StackPanel Spacing="7">
                    <Image
                        Source="ms-appx:///Assets/logoPrincipal.png"
                        Width="240" Height="240"
                        Margin="0,-25,0,0"
                        HorizontalAlignment="Center"/>

                    <TextBlock Text="BIENVENIDO" FontSize="25"
                               HorizontalAlignment="Center"
                               CharacterSpacing="200"
                               Margin="0,-40,0,0"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Selecciona tu perfil e ingresa tus credenciales" FontSize="11" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#8A99AA"/>

                    <Border Height="1" Background="#2E3F52" Margin="0,4,0,4"/>

                    <!-- SELECTOR DE PERFIL -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta Empleado -->
                        <Border x:Name="CardEmpleado"
                                Grid.Column="0"
                                Background="#162130"
                                CornerRadius="30"
                                BorderBrush="#E8611A"
                                BorderThickness="2"
                                Padding="10,14"
                                Tapped="CardEmpleado_Tapped"
                                IsHitTestVisible="True">

                            <StackPanel HorizontalAlignment="Center" Spacing="6">

                                <!-- Indicador selección -->
                                <Ellipse x:Name="DotEmpleado"
                                         Width="12" Height="12"
                                         Fill="#E8611A"
                                         HorizontalAlignment="Right"/>

                                <FontIcon x:Name="IconEmpleado"
                                          Glyph="&#xE77B;"
                                          FontSize="26"
                                          Foreground="#E8611A"
                                          HorizontalAlignment="Center"/>        

                                <TextBlock x:Name="LblEmpleado"
                                           Text="Empleado"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#E8611A"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Administrador -->
                        <Border x:Name="CardAdmin"
                                Grid.Column="2"
                                CornerRadius="30"
                                BorderThickness="1"
                                Padding="10,14"
                                Tapped="CardAdmin_Tapped"
                                IsHitTestVisible="True"
                                BorderBrush="#3A5068"
                                Background="#162130">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <!-- Indicador selección -->
                                <Ellipse x:Name="DotAdmin"
                                         Width="12" Height="12"
                                         Fill="Transparent"
                                         HorizontalAlignment="Right"/>
                                <FontIcon Glyph="&#xE7EF;" FontSize="26"
                                          x:Name="IconAdmin"
                                          Foreground="#8A99AA"
                                          HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LblAdmin"
                                           Text="Administrador"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#8A99AA"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBox
                        x:Name="UsernameTextBox"
                        Header="USUARIO"
                        FontSize="12"
                        MaxLength="20"
                        Margin="0,10,0,0"
                        KeyDown="CampoLogin_KeyDown"
                        BorderBrush="#3A5068"
                        Background="#131E2A"
                        Foreground="#EDF1F7"/>

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="CONTRASEÑA"
                        FontSize="12"
                        MaxLength="10"
                        KeyDown="CampoLogin_KeyDown"
                        BorderBrush="#3A5068"
                        Background="#131E2A"
                        Foreground="#EDF1F7"/>

                    <Button
                        x:Name="LoginButton"
                        HorizontalAlignment="Stretch"
                        Click="Login_Click"
                        Background="#E8611A"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0,14"
                        Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Ingresar al Sistema"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- solo Empleado -->
                    <HyperlinkButton
                        x:Name="LinkCrearCuenta"
                        Content="¿No tienes una cuenta? Da clic AQUI para crear una"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#8A99AA"
                        Click="LinkCrearCuenta_Click"
                        Visibility="Visible"/>

                    
                    <TextBlock
                        x:Name="StatusTextBlock"
                        FontSize="11"
                        CharacterSpacing="50"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
